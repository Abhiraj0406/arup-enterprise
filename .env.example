# ============================================================
# .env.example — Copy this to .env and fill in real values
# Place .env in the project root (outside public_html)
# !! This file IS safe to commit to Git !!
# ============================================================

# ----- Database (Hostinger MySQL credentials) -----
DB_HOST=localhost
DB_NAME=u463638053_arupweb
DB_USER=u463638053_arupweb
DB_PASS=your_strong_password_here
DB_CHARSET=utf8mb4

# ----- Application -----
# On live server set: APP_ENV=production
# On local machine set: APP_ENV=development
APP_ENV=production
APP_URL=https://arup-enterprise.com
APP_TIMEZONE=Asia/Kolkata

# ----- Email & Notifications -----
MAIL_FROM_ADDRESS=noreply@arup-enterprise.com
MAIL_FROM_NAME=Arup Enterprise
MAIL_NOTIFY_TO=enterprisearup@gmail.com

# ----- SMTP Settings (Hostinger Titan Mail / Webmail) -----
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=noreply@arup-enterprise.com
SMTP_PASS=your_email_account_password
SMTP_SECURE=ssl
