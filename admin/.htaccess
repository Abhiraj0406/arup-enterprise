# ============================================================
# admin/.htaccess — Admin Panel Security
# ============================================================

# ---- Clean URLs (remove .php extension) ----
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /admin/

    # ---- Force HTTPS ----
    RewriteCond %{HTTPS} off
    RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

    # ---- Remove .php extension from URLs ----
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME}.php -f
    RewriteRule ^(.*)$ $1.php [L]
</IfModule>

# ---- Disable directory listing ----
Options -Indexes

# ---- Block access to the Uploads folder listing ----
<IfModule mod_rewrite.c>
    RewriteRule ^Uploads/$ - [F,L]
    RewriteRule ^uploads/$ - [F,L]
</IfModule>

# ---- Rate limiting: limit login attempts ----
# This uses mod_rewrite to block repeated rapid requests to do_login.php
<IfModule mod_rewrite.c>
    # Block suspicious user agents targeting login
    RewriteCond %{HTTP_USER_AGENT} (libwww-perl|wget|python|nikto|curl|scan|java|winhttp|clshttp|loader) [NC,OR]
    RewriteCond %{HTTP_USER_AGENT} (<|>|'|%0A|%0D|%27|%3C|%3E|%00) [NC]
    RewriteRule ^do_login\.php$ - [F,L]
</IfModule>

# ---- PHP hardening for admin ----
<IfModule mod_php.c>
    php_flag  display_errors         Off
    php_flag  display_startup_errors Off
    php_flag  session.cookie_httponly On
    php_flag  session.cookie_secure   On
    php_value session.cookie_samesite "Strict"
    php_flag  session.use_strict_mode On
</IfModule>

# ---- Security Headers (repeated for admin subdirectory) ----
<IfModule mod_headers.c>
    Header always set X-Frame-Options "DENY"
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-XSS-Protection "1; mode=block"
    Header always set Referrer-Policy "no-referrer"
    Header always unset X-Powered-By
</IfModule>