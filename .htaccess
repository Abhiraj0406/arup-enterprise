# ============================================================
# .htaccess — Arup Enterprise / DipBan Technical Services
# Root-level Apache configuration
# ============================================================

# ---- Engine ----
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # ---- Force HTTPS ----
    RewriteCond %{HTTPS} off
    RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

    # ---- Remove www (choose one: remove or force-www) ----
    # To force www, swap the two lines below:
    # RewriteCond %{HTTP_HOST} !^www\. [NC]
    # RewriteRule ^ https://www.%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

    # ---- Default index ----
    DirectoryIndex index.php

    # ---- Clean URL rewriting ----
    RewriteRule ^index\.php$ - [L]
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule . /index.php [L]
</IfModule>

# ---- Security: Block direct access to sensitive files ----
<FilesMatch "(\.env|\.git|composer\.(json|lock)|package\.json|\.htpasswd)">
    Order allow,deny
    Deny from all
</FilesMatch>

# ---- Security: Block access to backup / log files ----
<FilesMatch "\.(sql|bak|log|sh|swp|orig)$">
    Order allow,deny
    Deny from all
</FilesMatch>

# ---- Disable directory listing ----
Options -Indexes

# ---- Block access to includes and PHPMailer source ----
<IfModule mod_rewrite.c>
    RewriteRule ^includes/$ - [F,L]
    RewriteRule ^PHPMailer/$ - [F,L]
</IfModule>

# ---- Security Headers ----
<IfModule mod_headers.c>
    # Prevent clickjacking
    Header always set X-Frame-Options "SAMEORIGIN"

    # XSS protection (legacy browsers)
    Header always set X-XSS-Protection "1; mode=block"

    # Prevent MIME-type sniffing
    Header always set X-Content-Type-Options "nosniff"

    # Referrer policy
    Header always set Referrer-Policy "strict-origin-when-cross-origin"

    # HSTS — tell browsers to always use HTTPS (6 months)
    # Enable ONLY after SSL is confirmed working on your live domain
    Header always set Strict-Transport-Security "max-age=15768000; includeSubDomains"

    # Content Security Policy — adjust sources as needed
    Header always set Content-Security-Policy "default-src 'self'; \
        script-src 'self' 'unsafe-inline' 'unsafe-eval' \
            https://cdn.jsdelivr.net \
            https://cdnjs.cloudflare.com \
            https://www.googletagmanager.com \
            https://maps.googleapis.com; \
        style-src 'self' 'unsafe-inline' \
            https://cdn.jsdelivr.net \
            https://cdnjs.cloudflare.com \
            https://fonts.googleapis.com; \
        font-src 'self' \
            https://fonts.gstatic.com \
            https://cdnjs.cloudflare.com; \
        img-src 'self' data: blob: \
            https://www.google.com \
            https://maps.googleapis.com \
            https://maps.gstatic.com; \
        frame-src 'self' \
            https://www.google.com \
            https://maps.google.com; \
        connect-src 'self' \
            https://maps.googleapis.com;"

    # Remove server signature
    Header always unset X-Powered-By
    Header always unset Server
</IfModule>

# ---- PHP Settings (shared hosting) ----
<IfModule mod_php.c>
    # Disable error display in production
    php_flag  display_errors         Off
    php_flag  display_startup_errors Off
    php_value error_reporting        32767

    # File upload limits
    php_value upload_max_filesize    10M
    php_value post_max_size          12M
    php_value max_execution_time     60
    php_value memory_limit           256M

    # Session security
    php_flag  session.cookie_httponly On
    php_flag  session.cookie_secure   On
    php_value session.cookie_samesite "Strict"
    php_flag  session.use_strict_mode On
</IfModule>

# ---- Compression (faster page loads) ----
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/xml
    AddOutputFilterByType DEFLATE text/css text/javascript
    AddOutputFilterByType DEFLATE application/javascript application/x-javascript
    AddOutputFilterByType DEFLATE application/json application/xml
</IfModule>

# ---- Browser Caching ----
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType image/jpeg "access plus 1 month"
    ExpiresByType image/png  "access plus 1 month"
    ExpiresByType image/gif  "access plus 1 month"
    ExpiresByType image/webp "access plus 1 month"
    ExpiresByType image/svg+xml "access plus 1 month"
    ExpiresByType image/x-icon "access plus 1 year"
    ExpiresByType text/css    "access plus 1 week"
    ExpiresByType text/javascript "access plus 1 week"
    ExpiresByType application/javascript "access plus 1 week"
</IfModule>
