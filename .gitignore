# ============================================================
# .gitignore — Arup Enterprise
# ============================================================

# ----- NEVER commit secrets -----
.env
.env.local
.env.*.local
*.env
**/.env

# ----- Uploads (user & admin media) -----
uploads/
public_html/uploads/
public_html/admin/uploads/
public_html/admin/Uploads/

# ----- System / IDE files -----
.DS_Store
Thumbs.db
*.swp
*.swo
*.orig
.idea/
.vscode/
*.sublime-project
*.sublime-workspace

# ----- PHP composer -----
vendor/
composer.lock

# ----- Node (if ever used) -----
node_modules/
npm-debug.log*
package-lock.json

# ----- Log files -----
*.log
error_log
php_error.log
storage/logs/

# ----- Database dumps (keep only base schema) -----
*.sql
*.sql.gz
*.dump
!database/schema.sql

# ----- Backup files -----
*.bak
*.backup
*~

# ----- Cache directories -----
cache/
tmp/
temp/
